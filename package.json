{
  "name": "@codename/deck",
  "version": "0.4.0",
  "description": "Slide decks as one web page: Markdown in Slidev's form inside a .deck.html file any browser presents, a renderer that runs anywhere, kits of layouts and looks, and an editable PowerPoint out",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/deck.mjs"
    },
    "./bundle": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/deck.bundle.mjs"
    },
    "./file": "./dist/deck.js",
    "./css": "./dist/deck.css",
    "./template": {
      "types": "./dist/types/template.d.ts",
      "default": "./dist/template.mjs"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "slides",
    "presentation",
    "markdown",
    "slidev",
    "powerpoint",
    "pptx"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.types.json",
    "examples": "npm run build && node examples/make.mjs",
    "test": "node --test test/*.test.js",
    "test:browsers": "npm run examples && node test/browser.mjs && node test/kit-browser.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:browsers",
    "eval": "node eval/run.mjs",
    "eval:check": "node eval/check.mjs && node eval/dialects/check.mjs && node eval/dialects/draw.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "pele": "^1.10.0",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
